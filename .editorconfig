# .editorconfig — zsh-fancy-completions
# -*- mode: editorconfig -*-

root = true

# ‑‑‑‑‑‑‑‑‑ Universal defaults ‑‑‑‑‑‑‑‑‑
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# ‑‑‑‑‑‑‑‑‑ Shell scripts ‑‑‑‑‑‑‑‑‑
[*.{sh,bash,zsh}]
end_of_line = lf

# Plugin entry point
[*.plugin.zsh]
end_of_line = lf

# ‑‑‑‑‑‑‑‑‑ Markdown ‑‑‑‑‑‑‑‑‑
# Trailing spaces can be significant (hard line breaks)
[*.md]
trim_trailing_whitespace = false

# ‑‑‑‑‑‑‑‑‑ YAML (GitHub Actions, Trunk configs) ‑‑‑‑‑‑‑‑‑
[*.{yml,yaml}]
indent_size = 2
